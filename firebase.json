{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "python312",
      "ignore": ["venv", "__pycache__", "*.pyc", ".env*"]
    }
  ],
  "hosting": {
    "public": "public",
    "ignore": ["firebase.json", "**/.*"],
    "headers": [
      { "source": "**", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
    ],
    "rewrites": [
      { "source": "**", "function": { "functionId": "page", "region": "europe-west1" } }
    ]
  }
}
